{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
      "target": "es2015",
      "module": "NodeNext",
      "types": ["react", "jest", "node"],
      "lib": ["esnext"],
      "allowJs": true,
      "checkJs": false,
      "jsx": "react",
      "isolatedModules": true,
      "strict": true,
      "moduleResolution": "NodeNext",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "declaration": true,
      "outDir": "./dist"
  },
  "exclude": ["**/node_modules/**/*", "**/dist/**/*"]
}
